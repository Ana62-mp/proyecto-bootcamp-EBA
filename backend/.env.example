# --- PostgreSQL instalado directamente o remoto (ver README) ---
DATABASE_URL="postgresql://app_user:app_pass@localhost:5432/app_db"

# --- Consulta vehicular por placa (solo backend; nunca usar prefijos VITE_) ---
# false desactiva el proveedor: la búsqueda local sigue funcionando y los
# vehículos no registrados responden 503 VEHICLE_PROVIDER_UNAVAILABLE.
WEBSERVICES_EC_ENABLED=true
WEBSERVICES_EC_BASE_URL=https://webservices.ec/api
# Obligatorio cuando WEBSERVICES_EC_ENABLED=true. No commitear un token real.
WEBSERVICES_EC_TOKEN=
WEBSERVICES_EC_TIMEOUT_MS=8000
# Consultas de placa permitidas por actor (máquina o admin) y por minuto.
VEHICLE_LOOKUP_RATE_LIMIT_PER_MINUTE=30
# Horas durante las que una consulta al proveedor certifica la procedencia al registrar el vehículo.
VEHICLE_LOOKUP_SNAPSHOT_TTL_HOURS=24

# --- JWT (mínimo 32 caracteres) ---
JWT_SECRET=cambia_este_valor_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# --- Servidor ---
# El frontend (Vite) usa el puerto 3000, por eso la API escucha en 3001.
PORT=3001
NODE_ENV=development

# --- CORS / frontend (uno o varios orígenes separados por coma) ---
FRONTEND_URL=http://localhost:3000
# Socket.IO comparte PORT con HTTP; no necesita un puerto extra.
# Namespace fijo /tickets-emision; path de transporte /socket.io.

# --- Cookie httpOnly del refresh token ---
# lax sirve cuando front y API comparten sitio (proxy de Vite en dev, mismo dominio en prod).
# Si el front vive en otro dominio, usar 'none' (obliga a HTTPS).
COOKIE_SAMESITE=lax
# Se activa solo en producción si se omite.
# COOKIE_SECURE=true
COOKIE_PATH=/
# false (default): cookie de sesión, se borra al cerrar el navegador.
# true: persiste en disco hasta agotar JWT_REFRESH_EXPIRES_IN (estilo "recordarme").
COOKIE_PERSISTENT=false
